GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Supabase Storage (durable PDFs on Render free). Private bucket, e.g. vera-materials:
# Used for original materials (materials/…) and finalized PDFs (finalized/…).
# Same bucket is fine; prefixes keep objects separated.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_STORAGE_BUCKET=vera-materials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vera-materials

# Delete finalized PDFs older than N days (0 = keep forever).
# Sweeps on startup, on a background timer, and when listing history.
# FINALIZED_RETENTION_DAYS=14
# FINALIZED_RETENTION_CLEANUP_SECONDS=3600
FINALIZED_RETENTION_DAYS=14
FINALIZED_RETENTION_CLEANUP_SECONDS=3600

# OCR for scanned / text-poor PDFs (requires tesseract in the image).
# OCR_MIN_CHARS_PER_PAGE=40
# OCR_MIN_TOTAL_CHARS=120
# OCR_LANGUAGE=spa+eng
# OCR_TIMEOUT_SECONDS=600
# OCR_FORCE_ALL=false
# OCR_DESKEW=true
# OCR_ROTATE_PAGES=true
OCR_LANGUAGE=spa+eng
OCR_FORCE_ALL=false
OCR_DESKEW=true
OCR_ROTATE_PAGES=true
