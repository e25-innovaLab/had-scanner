GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Supabase Storage (durable PDFs on Render free). Private bucket, e.g. vera-materials:
# Used for original materials (materials/…) and finalized PDFs (finalized/…).
# Same bucket is fine; prefixes keep objects separated.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_STORAGE_BUCKET=vera-materials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vera-materials

# Delete finalized PDFs older than N days when the API starts (0 = keep forever).
# FINALIZED_RETENTION_DAYS=14
FINALIZED_RETENTION_DAYS=14
