{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "mock/**/*.ts",
    "src/lib/api/service.ts",
    "src/lib/api/store.ts",
    "src/lib/api/seed.ts",
    "src/lib/api/types.ts",
    "src/lib/aula.ts"
  ]
}

